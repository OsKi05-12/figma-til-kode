---
import DynamicIcon from "@helpers/DynamicIcon.astro";
import Layout from "@layouts/Layout.astro";
import CoreValues from "@components/CoreValues.astro";
import FAQ from "@components/FAQ.astro";
import PageHeader from "@components/PageHeader.astro";

import { Image } from "astro:assets";
import ourVision from "../assets/images/our-vision.png";
import { getTeamMembers } from "@lib/api";

const team = await getTeamMembers();
const previewTeam = team.slice(0, 2);
---

<Layout title="About">
  <main id="main-content" tabindex="-1" class="about-page page-grid">
    <PageHeader
      eyebrow="About"
      title="Igniting Innovation"
      description="Our strength lies in the collaboration between our talented teams and esteemed clients. We cultivate a workplace that champions innovation, promotes peak performance, and guarantees client satisfaction."
      lineDirection="right"
    />

    <section class="vision" aria-labelledby="vision-title">
      <div class="vision-content">
        <p class="eyebrow">Our vision</p>

        <h2 id="vision-title">Turn your ideas into reality.</h2>

        <p>
          Capitalize on low hanging fruit to identify a ballpark value added
          activity to beta test. Override the digital divide with additional
          from DevOps.
        </p>

        <ul>
          <li>
            <DynamicIcon
              name="checkmark"
              width={20}
              height={20}
              aria-hidden="true"
            />

            <span>
              Bring to the table win-win survival strategies to ensure proactive
              domination. At the end of the day.
            </span>
          </li>

          <li>
            <DynamicIcon
              name="checkmark"
              width={20}
              height={20}
              aria-hidden="true"
            />

            <span>
              Capitalize on low hanging fruit to identify a ballpark value added
              activity to beta test. Override the digital divide.
            </span>
          </li>
        </ul>
      </div>

      <div class="vision-image">
        <Image
          src={ourVision}
          alt="Three people working together around a table with a laptop and books"
          sizes="(max-width: 750px) 100vw, 40vw"
        />
      </div>
    </section>

    <section class="stats" aria-label="Company statistics">
      <div>
        <strong>1128+</strong>
        <p>Successful Work</p>
      </div>

      <div>
        <strong>908+</strong>
        <p>Team member</p>
      </div>

      <div>
        <strong>258+</strong>
        <p>Happy Customers</p>
      </div>

      <div>
        <strong>564+</strong>
        <p>Creative Idea</p>
      </div>
    </section>

    <div class="values-section full-width">
      <CoreValues />
    </div>

    <section class="team-preview shared-columns">
      <div class="team-heading">
        <p class="eyebrow">Our team</p>
        <h2>We champion the bold</h2>

        <p>
          Our success stems from the synergy between dedicated teams and our
          valued clients. We prioritize a company culture that fosters
          exceptional productivity, ensures customer satisfaction.
        </p>

        <a class="team-button" href="/team">
          Meet the Team
        </a>
      </div>

      <div class="people">
        {previewTeam.map((employee) => (
          <article class="person">
            <a href={`/team/${employee.slug}`}>
              <Image
                {...employee.image}
                alt={employee.name}
              />
            </a>

            <div>
              <h3>
                <a href={`/team/${employee.slug}`}>
                  {employee.name}
                </a>
              </h3>

              <strong>{employee.title}</strong>
              <p>{employee.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="faq-section">
      <FAQ />
    </div>
  </main>
</Layout>

<style>
  @layer components {
    h2 {
      font-size: var(--font-size-heading-medium);
      margin-block: 0 var(--space-small);
    }

    .vision,
    .team-preview {
      display: grid;
      align-items: center;
      column-gap: var(--space-medium);
      row-gap: var(--space-medium);
      padding-block: var(--space-section);
    }

    .vision {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      column-gap: var(--space-large);
    }

    .vision-content,
    .vision-image,
    .team-heading,
    .people {
      min-width: 0;
    }

    .vision-content {
      max-width: 60ch;
    }

    .vision ul {
      list-style: none;
      padding: 0;
      margin-block: var(--space-medium) 0;
    }

    .vision li {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .vision li :global(svg) {
      flex-shrink: 0;
      color: var(--color-green-600);
    }

    .vision li + li {
      margin-top: var(--space-small);
    }

    /* Den grønne form placeres bag fotoets øverste højre hjørne. */
    .vision-image {
      position: relative;
      isolation: isolate;
      padding-top: 0.75rem;
      padding-right: 1.25rem;
    }

    .vision-image::before {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      width: 25%;
      height: 32%;
      border-radius: var(--radius-large);
      background: var(--color-green-400);
      z-index: -1;
    }

    .vision-image img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1.4;
      object-fit: cover;
      border-radius: var(--radius-large);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-medium);
      padding-bottom: var(--space-section);
      text-align: center;
    }

    .stats strong {
      font-size: 2.5rem;
      font-family: var(--font-cabin);
    }

    .stats p {
      margin-bottom: 0;
    }

    .team-button {
      display: inline-block;
      margin-top: var(--space-small);
      padding: 0.85rem 1.5rem;
      background: var(--color-text);
      color: white;
      border-radius: var(--radius-pill);
      text-decoration: none;
    }

    .people {
      display: grid;
      gap: var(--space-medium);
    }

    .person {
      display: grid;
      grid-template-columns: 130px minmax(0, 1fr);
      align-items: center;
      gap: var(--space-small);
    }

    .person img {
      width: 130px;
      height: 150px;
      object-fit: cover;
      border-radius: var(--radius-large);
    }

    .person h3 {
      margin-block: 0 0.5rem;
      font-size: var(--font-size-heading-small);
    }

    .person h3 a {
      text-decoration: none;
    }

    .person h3 a:hover {
      text-decoration: underline;
    }

    .person p {
      margin-block: 0.5rem 0;
      color: var(--color-text-muted);
      font-size: 0.9375rem;
    }

    .faq-section {
      padding-block: var(--space-section);
      max-width: 850px;
      width: 100%;
      margin-inline: auto;
    }

    @media (max-width: 750px) {
      .vision,
      .team-preview {
        grid-template-columns: 1fr;
      }

      .vision-image {
        width: 100%;
        max-width: 550px;
        justify-self: center;
      }

      .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 400px) {
      .person {
        grid-template-columns: 1fr;
      }
    }
  }
</style>